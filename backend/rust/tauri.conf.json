{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jujuba",
  "mainBinaryName": "jujubasql",
  "version": "0.1.76",
  "identifier": "br.nexosql.studio",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../frontend" },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      { "label": "startup", "title": "Abrindo o JUJUBA", "url": "splash.html", "width": 560, "height": 320, "center": true, "preventOverflow": true, "decorations": false, "resizable": false, "maximizable": false, "backgroundColor": "#170d20" },
      { "label": "main", "title": "JUJUBA", "width": 1380, "height": 850, "center": true, "preventOverflow": { "width": 24, "height": 24 }, "visible": false, "backgroundColor": "#080808" }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwN0Q1RUM2QjA4Nzk0REYKUldUZmxJZXd4bDU5Z0Z2ZE14U3loMStGUWJ4aTBQNlh6N2FiN1dyTUpnek9QdzNhVVNvZU04UHIK",
      "endpoints": ["https://github.com/valentelucass/jujuba/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": { "active": true, "resources": ["resources/source-monitor.mjs", "resources/source-worker.mjs", "resources/source-processes.mjs"], "targets": ["nsis"], "icon": ["icons/icon.ico"], "windows": { "nsis": { "installerHooks": "windows/upgrade-brand.nsh", "installerIcon": "icons/icon.ico", "installMode": "currentUser", "languages": ["PortugueseBR", "English"] } } }
}
